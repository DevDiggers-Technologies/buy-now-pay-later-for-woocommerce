<?xml version="1.0"?>
<ruleset name="DevDiggers Buy Now Pay Later for WooCommerce">
	<description>WordPress Coding Standards for this plugin. The bundled devdiggers-framework is checked in its own repository, so it is excluded here.</description>

	<file>.</file>

	<exclude-pattern>*/devdiggers-framework/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/i18n/*</exclude-pattern>
	<!-- Build scripts, excluded from the release zip by .distignore. -->
	<exclude-pattern>*/bin/*</exclude-pattern>
	<!-- WP-CLI integration check, not shipped. -->
	<exclude-pattern>*/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<!-- Single process: the parallel runner on this toolchain silently scans only the
		 first chunk of files, which reports a clean run over a fraction of the plugin. -->
	<arg name="parallel" value="1"/>

	<rule ref="WordPress">
		<!-- This is a premium plugin distributed outside the WordPress.org
			 directory, so the directory only packaging sniffs do not apply. -->
		<exclude name="WordPress.WP.CapitalPDangit"/>

		<!-- Short array syntax is the house style across every DevDiggers plugin
			 and the shared framework. Switching this one plugin to array() would
			 make it the odd one out for no benefit. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>

		<!-- The autoloader maps a class name onto a lowercase hyphenated path,
			 so file names deliberately omit the class- prefix. Renaming the files
			 to satisfy this sniff would stop every class from loading. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>

		<!-- A WooCommerce extension has to fire WooCommerce's own hooks, so the
			 ones the plugin listens to are not its to prefix. Hooks the plugin
			 itself defines are prefixed. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound"/>
	</rule>

	<!-- WooCommerce's own capability, which this sniff only knows about for core. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- Callbacks have to match the signature of the hook that calls them, so an
		 unused trailing argument is the hook's shape and not dead code. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>*/includes/*</exclude-pattern>
	</rule>

	<!-- Directory blockers, which carry a silence comment rather than a file
		 docblock, exactly as WordPress core writes them. -->
	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>*/index.php</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="5.0"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="devdiggers-buy-now-pay-later-for-woocommerce"/>
				<element value="woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ddwcpp"/>
				<element value="DDWCPP"/>
				<element value="DDWCPostPaid"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>
</ruleset>
